.stripTitle{
     margin-top: 24px;
     position: relative;
}
 .box, .menu, .explore{
    /* height: 257px;
     width: 185px;
    */
    float: left;
    /* opacity: .8; */
    height: 419px;
    width: 276px;
    /* margin-right: -1px; */
}
 .box.onFocus,  .menu.onFocus{
     cursor: pointer;
}

.menu p, .explore p.nomGenre{
     background: rgba(0, 0, 0, 0.5);
     margin-top: 0px;
     width: 192px;
     text-align: center;
     font-size: 22px;
     padding-top: 220px;
     height: 70px;
}

.explore p.nomGenre{padding-top: 200px;height: 92px;font-size: 25px;font-family: Brandon Bold;}

.menu.onFocus > p{
	outline: solid 3px #eb564a;
	cursor: pointer;
	margin-left: 3px;
    color: #eb564a;
}

.menu.estrenos.onFocus > p{
	outline: solid 3px #009D72;
	cursor: pointer;
}
